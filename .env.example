# ═══════════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT VARIABLES — Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
TOKEN_SECRET_KEY=generate_with__node_-e_console.log(require('crypto').randomBytes(64).toString('hex'))
FRONTEND_URL=http://localhost:5173
PORT=8080

# ── Cloudinary ────────────────────────────────────────────────────────
# Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# ── Redis (Upstash) ───────────────────────────────────────────────────
# Dashboard: https://upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# ── Email (Gmail SMTP) ────────────────────────────────────────────────
# Setup: Gmail → Account → Security → App Passwords
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
ADMIN_EMAIL=your.email@gmail.com
OTP_TTL_MINUTES=5
OTP_RESEND_LIMIT=3

# ── Razorpay ─────────────────────────────────────────────────────────
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_secret

# ── Google Gemini (AI LLM + Embeddings) ──────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
# Key format: AIzaSy... (39 chars, starts with AIza)
GEMINI_API_KEY=AIzaSy...your_39_char_key

# ── Pinecone (RAG Vector Database) ───────────────────────────────────
# Dashboard: https://app.pinecone.io
# Index settings: dimensions=768, metric=cosine
PINECONE_API_KEY=pcsk_...your_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=stm-knowledge-base

# ── AI Agent Settings ─────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1024
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_MS=25000
AGENT_MAX_HISTORY_TURNS=10

# ── Voice (Speech-to-Text) ────────────────────────────────────────────
# STT_PROVIDER=whisper requires OPENAI_API_KEY
# Get key: https://platform.openai.com/api-keys  (starts with sk-)
STT_PROVIDER=whisper
OPENAI_API_KEY=sk-...your_openai_key
TTS_PROVIDER=browser
AUDIO_MAX_SIZE_MB=10

# ── RAG Tuning ────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.6
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ── Rate Limiting ─────────────────────────────────────────────────────
AI_CHAT_RATE_LIMIT=30
AI_VOICE_RATE_LIMIT=10
AI_RATE_WINDOW_MINS=1

# ── Mistral (only if LLM_PROVIDER=mistral) ────────────────────────────
# Get key: https://console.mistral.ai/api-keys
# Install: npm install @langchain/mistralai
# MISTRAL_API_KEY=your_key_here
# MISTRAL_MODEL=mistral-medium
